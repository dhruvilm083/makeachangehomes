# Cloudflare response headers.
# Photos, fonts and the Webflow stylesheet never change in place (new files get new names),
# so browsers can keep them for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pages, /css and /js keep their names when they change, so browsers check back,
# but may show the copy they already have instantly while fetching the update in
# the background (stale-while-revalidate). A deploy shows up within a few minutes.
/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/js/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
